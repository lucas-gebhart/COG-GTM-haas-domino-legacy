<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE view SYSTEM 'xmlschemas/domino_12_0.dtd'>
<view name='WarehousePick' alias='Pick|vwPick' xmlns='http://www.lotus.com/dxl' version='12.0'
 maintenanceversion='2.0' replicaid='C1258A1F00305D71' designerversion='8.5.3' publicaccess='false'
 showresponsehierarchy='false' showinmenu='true' onopengoto='lastopened' onrefresh='displayindicator'
 headers='beveled' opencollapsed='false' showmargin='true' shrinkrows='false' extendlastcolumn='true'
 unreadmarks='none' rowlinecount='1' headerlinecount='1' unreadcolor='black' bgcolor='white' altrowcolor='#f0f0f0'
 headerbgcolor='#c0c0c0' boldunreadrows='false' evaluateactions='false' allownewdocuments='false'
 nomenu='false' allowcustomizations='true'>
<noteinfo noteid='156' unid='A6B7C8D9EAFB0C1D85258A1F00305D71' sequence='69'>
<created><datetime>20040305T094500,00-05</datetime></created>
<modified><datetime>20230110T104417,00-05</datetime></modified>
</noteinfo>
<updatedby><name>CN=Domino Developer/O=HAAS</name></updatedby>
<code event='selection'><formula>SELECT Form = &quot;AwardsCase&quot; &amp; Stage = &quot;Warehouse&quot; &amp; !@IsAvailable($Conflict)</formula></code>
<actionbar bgcolor='system' bordercolor='black'>
<action title='Create Shipment' icon='5'><code event='hidewhen'><formula>!@IsMember(&quot;[Warehouse]&quot;:&quot;[TACOM]&quot;; @UserRoles)</formula></code><code event='click'><formula>@Command([Compose]; &quot;ShipmentRecord&quot;)</formula></code></action>
<action title='Picked -&gt; Ship Confirm' icon='14'><code event='hidewhen'><formula>!@IsMember(&quot;[Warehouse]&quot;:&quot;[TACOM]&quot;; @UserRoles)</formula></code><code event='click'><formula>@Command([ToolsRunMacro]; &quot;(AdvanceStage)&quot;)</formula></code></action>
<action title='Print Pick List' icon='23'><code event='click'><formula>@Command([FilePrint]; &quot;1&quot;; &quot;0&quot;; &quot;PickList&quot;)</formula></code></action>
</actionbar>
<column itemname='PriorityCat' width='14' resizable='true' sort='ascending' categorized='true' twisties='true'>
<font size='9pt' style='bold' name='Arial'/>
<columnheader title='Priority'/>
<code event='value'><formula>@If(Priority = &quot;Congressional&quot;; &quot;1. Congressional&quot;; Priority = &quot;Expedite&quot;; &quot;2. Expedite&quot;; &quot;3. Routine&quot;)</formula></code>
</column>
<column itemname='WarehouseDate' width='12' resizable='true' sort='ascending'>
<font size='9pt' name='Arial'/>
<datetimeformat show='date' date='monthdayyear' time='hourminute' zone='never'/>
<columnheader title='Released to Warehouse'/>
<code event='value'><formula>@Text(WarehouseDate; &quot;D0S0&quot;)</formula></code>
</column>
<column itemname='CaseNumber' width='16' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Case'/>
<code event='value'><formula>CaseNumber</formula></code>
</column>
<column itemname='ShipTo' width='36' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Ship To'/>
<code event='value'><formula>ShipToName + &quot;, &quot; + ShipToCity + &quot; &quot; + ShipToState + &quot; &quot; + ShipToZIP</formula></code>
</column>
<column itemname='LineCount' width='5' resizable='true' align='right'>
<font size='9pt' name='Arial'/>
<columnheader title='Lines'/>
<code event='value'><formula>@Text(LineCount)</formula></code>
</column>
<column itemname='PickBin' width='8' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Bin'/>
<code event='value'><formula>PickBin</formula></code>
</column>
<column itemname='Deceased' width='14' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='NOK'/>
<code event='value'><formula>@If(Deceased = &quot;Yes&quot;; &quot;NOK - &quot; + Relationship; &quot;&quot;)</formula></code>
</column>
<column itemname='DaysInStage' width='5' resizable='true' align='right'>
<font size='9pt' name='Arial'/>
<columnheader title='Days'/>
<code event='value'><formula>@Text(DaysInStage)</formula></code>
</column>
<column itemname='AgingFlag' width='6' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Aging'/>
<code event='value'><formula>AgingFlag</formula></code>
</column>
<item name='$Comment'><text>Warehouse pick list: cases awaiting pick/pack. Rendered by the harness at /vetmedals.nsf/WarehousePick?OpenView.</text></item>
</view>
