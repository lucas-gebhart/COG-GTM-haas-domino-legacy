<code event='selection'><formula>SELECT @All</formula></code>
<column itemname='Form' width='16' resizable='true' sort='ascending' categorized='true' twisties='true'>
<font size='9pt' style='bold' name='Arial'/>
<columnheader title='Form'/>
<code event='value'><formula>Form</formula></code>
</column>
<column itemname='Key' width='24' resizable='true' sort='ascending'>
<font size='9pt' name='Arial'/>
<columnheader title='Key'/>
<code event='value'><formula>@If(Form = &quot;AwardsCase&quot;; CaseNumber; Form = &quot;AwardLine&quot;; LineKey; Form = &quot;Requester&quot;; RequesterID; Form = &quot;EngravingJob&quot;; JobNumber; Form = &quot;ShipmentRecord&quot;; ShipmentNumber; Form = &quot;AuthorizationFile&quot;; FileName; Form = &quot;CaseNote&quot;; ParentCaseNumber; @Text(@DocumentUniqueID))</formula></code>
</column>
<column itemname='Modified' width='16' resizable='true'>
<font size='9pt' name='Arial'/>
<datetimeformat show='datetime' date='monthdayyear' time='hourminute' zone='never'/>
<columnheader title='Modified'/>
<code event='value'><formula>@Text(@Modified; &quot;D0S1&quot;)</formula></code>
</column>
<column itemname='UpdatedBy' width='20' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Last Updated By'/>
<code event='value'><formula>@Name([CN]; @Subset($UpdatedBy; -1))</formula></code>
</column>
