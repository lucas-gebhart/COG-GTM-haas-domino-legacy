<databasescript>
<code event='postopen'><lotusscript>Sub Postopen(Source As Notesuidatabase)
	' Warn CSRs when the nightly aging agent has not run (AgingLastRun older than 36 hours)
	Dim s As New NotesSession
	Dim prof As NotesDocument
	Dim lastRun As Variant
	Set prof = Source.Database.GetProfileDocument("Profile")
	If prof Is Nothing Then Exit Sub
	If prof.HasItem("AgingLastRun") Then
		lastRun = prof.GetItemValue("AgingLastRun")(0)
		If IsDate(lastRun) Then
			If (Now - CDat(lastRun)) &gt; 1.5 Then
				Msgbox "NightlyAging has not run since " &amp; Format$(lastRun, "mm/dd/yyyy hh:nn") &amp; ". Aging flags may be stale.", 48, "Veteran Medals &amp; Awards"
			End If
		End If
	End If
End Sub</lotusscript></code>
</databasescript>
<launchsettings>
<noteslaunch whenopened='openframeset' frameset='fsCases'/>
<weblaunch whenopened='openview' view='CasesByStage'/>
</launchsettings>
<!--
  HAAS - Veteran Medals & Awards Case System (vetmedals.nsf)
  ===========================================================================
  SYNTHETIC design export - a stand-in for the awards-fulfilment half of the
  Clothing & Heraldry PSID mission. Nothing here is copied from, or claims to be,
  the real internal design.

  Business flow modelled:
    NPRC (St. Louis) / Army HRC determine eligibility and transmit an electronic
    authorization file  ->  ImportAuthorizationFile creates AwardsCase + AwardLine
    documents and a Requester (veteran / next-of-kin)  ->  CSR review  ->
    Engraving (EngravingJob)  ->  Assembly / QC  ->  Warehouse pick  ->
    Ship (ShipmentRecord)  ->  Closed.  Historic target: case complete within
    60-75 days of entry (NightlyAging flags 60 = amber, 75 = red).

  Design summary:
    Forms   : AwardsCase, AwardLine (response), Requester, AuthorizationFile,
              EngravingJob, ShipmentRecord, CaseNote (response), Profile
    Views   : CasesByStage, CasesByAuthDate, AgingCases, EngravingQueue,
              AssemblyQueue, WarehousePick, ShipConfirm, CSRLookup, ($All)
    Agents  : ImportAuthorizationFile (manual / on file arrival), NightlyAging
              (scheduled 01:00), ArchiveClosedCases (scheduled weekly Sunday)
    XPages  : CaseView, EngravingQueue, CSRLookup; ccLayout / ccStatusBanner (copies)
    Script  : HAASCommon (copy of heraldry.nsf library, drifted), HAASAwards
-->
