<?xml version="1.0" encoding="UTF-8"?>
<faces-config>
  <!-- vetmedals.nsf - JSF configuration for the XPages runtime (WebContent/WEB-INF/faces-config.xml) -->
  <application>
    <locale-config>
      <default-locale>en_US</default-locale>
      <supported-locale>en_US</supported-locale>
    </locale-config>
    <message-bundle>haas.awards.messages</message-bundle>
  </application>

  <!-- Managed beans -->
  <managed-bean>
    <managed-bean-name>awardsConfig</managed-bean-name>
    <managed-bean-class>mil.army.tacom.haas.awards.ConfigBean</managed-bean-class>
    <managed-bean-scope>application</managed-bean-scope>
    <managed-property>
      <property-name>profileForm</property-name>
      <value>Profile</value>
    </managed-property>
    <managed-property>
      <property-name>stages</property-name>
      <value>Authorized,Engraving,Assembly/QC,Warehouse,Shipped,Closed</value>
    </managed-property>
    <managed-property>
      <property-name>agingAmberDays</property-name>
      <value>60</value>
    </managed-property>
    <managed-property>
      <property-name>agingRedDays</property-name>
      <value>75</value>
    </managed-property>
  </managed-bean>
  <managed-bean>
    <managed-bean-name>caseLookup</managed-bean-name>
    <managed-bean-class>mil.army.tacom.haas.awards.CaseLookupBean</managed-bean-class>
    <managed-bean-scope>request</managed-bean-scope>
  </managed-bean>
  <managed-bean>
    <managed-bean-name>userInfo</managed-bean-name>
    <managed-bean-class>mil.army.tacom.haas.UserInfoBean</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
  </managed-bean>

  <!-- Custom converters / validators referenced from XPages -->
  <converter>
    <converter-id>haas.CaseNumberConverter</converter-id>
    <converter-class>mil.army.tacom.haas.awards.convert.CaseNumberConverter</converter-class>
  </converter>
  <validator>
    <validator-id>haas.EngravingTextValidator</validator-id>
    <validator-class>mil.army.tacom.haas.awards.validate.EngravingTextValidator</validator-class>
  </validator>

  <!-- Same audit phase listener as heraldry.nsf (jar is shared via the server's osgi plugin) -->
  <lifecycle>
    <phase-listener>mil.army.tacom.haas.AuditPhaseListener</phase-listener>
  </lifecycle>
  <!--AUTOGEN-START-BUILDER: Automatically generated by IBM Domino Designer. Do not modify.-->
  <!--AUTOGEN-END-BUILDER: End of automatically generated section-->
</faces-config>
