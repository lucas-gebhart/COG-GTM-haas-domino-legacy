<?xml version="1.0" encoding="UTF-8"?>
<faces-config>
  <!-- heraldry.nsf - JSF configuration for the XPages runtime (WebContent/WEB-INF/faces-config.xml) -->
  <application>
    <locale-config>
      <default-locale>en_US</default-locale>
      <supported-locale>en_US</supported-locale>
    </locale-config>
    <message-bundle>haas.messages</message-bundle>
  </application>

  <!-- Managed beans -->
  <managed-bean>
    <managed-bean-name>haasConfig</managed-bean-name>
    <managed-bean-class>mil.army.tacom.haas.ConfigBean</managed-bean-class>
    <managed-bean-scope>application</managed-bean-scope>
    <managed-property>
      <property-name>profileForm</property-name>
      <value>Profile</value>
    </managed-property>
    <managed-property>
      <property-name>releasedStatuses</property-name>
      <value>Released to Vendor,In Production,Shipped,Complete,Cancelled</value>
    </managed-property>
  </managed-bean>
  <managed-bean>
    <managed-bean-name>statusInquiry</managed-bean-name>
    <managed-bean-class>mil.army.tacom.haas.StatusInquiryBean</managed-bean-class>
    <managed-bean-scope>request</managed-bean-scope>
  </managed-bean>
  <managed-bean>
    <managed-bean-name>userInfo</managed-bean-name>
    <managed-bean-class>mil.army.tacom.haas.UserInfoBean</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
  </managed-bean>

  <!-- Custom converters / validators referenced from XPages -->
  <converter>
    <converter-id>haas.DodaacConverter</converter-id>
    <converter-class>mil.army.tacom.haas.convert.DodaacConverter</converter-class>
  </converter>
  <validator>
    <validator-id>haas.UicValidator</validator-id>
    <validator-class>mil.army.tacom.haas.validate.UicValidator</validator-class>
  </validator>

  <!-- Phase listener that logs every XPage request to haaslog.nsf (added 2016 for the IG audit) -->
  <lifecycle>
    <phase-listener>mil.army.tacom.haas.AuditPhaseListener</phase-listener>
  </lifecycle>
  <!--AUTOGEN-START-BUILDER: Automatically generated by IBM Domino Designer. Do not modify.-->
  <!--AUTOGEN-END-BUILDER: End of automatically generated section-->
</faces-config>
