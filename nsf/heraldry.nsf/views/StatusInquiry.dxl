<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE view SYSTEM 'xmlschemas/domino_12_0.dtd'>
<view name='StatusInquiry' alias='vwStatusInquiry|(StatusInquiryLookup)' xmlns='http://www.lotus.com/dxl' version='12.0'
 maintenanceversion='2.0' replicaid='C1258A1F00305C22' designerversion='8.5.3' publicaccess='true'
 showresponsehierarchy='false' showinmenu='false' onopengoto='top' headers='beveled' opencollapsed='false'
 bgcolor='white' headerbgcolor='#c0c0c0' rowlinecount='1' headerlinecount='1' uniquekeys='false'>
<noteinfo noteid='14A' unid='E5F6A7B8C9D0E1F285258A1F00305C22' sequence='31'>
<created><datetime>20080114T090000,00-05</datetime></created>
<modified><datetime>20220214T151049,00-05</datetime></modified>
</noteinfo>
<updatedby><name>CN=Domino Developer/O=HAAS</name><name>CN=Renata Vasquez-Holm/OU=CHPSID/O=TACOM</name></updatedby>
<code event='selection'><formula>SELECT (Form = "Request" | Form = "SESFlagRequest") &amp; !@IsAvailable($Conflict) &amp; !@IsAvailable($Archived)</formula></code>
<column itemname='StatusInquiryKey' width='1' resizable='false' sort='ascending' hidden='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Key'/>
<code event='value'><formula>@UpperCase(@If(Form = "SESFlagRequest"; SESFlagNumber; DocumentNumber)) : @UpperCase(DODAAC) : @UpperCase(UIC)</formula></code>
</column>
<column itemname='DocumentNumber' width='16' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Document Number'/>
<code event='value'><formula>@If(Form = "SESFlagRequest"; SESFlagNumber; DocumentNumber)</formula></code>
</column>
<column itemname='Status' width='18' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Status'/>
<code event='value'><formula>@If(@Trim(Status) = ""; "(No Status)"; Status)</formula></code>
</column>
<column itemname='EnteredDate' width='10' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Entered'/>
<code event='value'><formula>@Text(EnteredDate; "D0S0")</formula></code>
</column>
<column itemname='ReleasedDate' width='10' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Released to Vendor'/>
<code event='value'><formula>@If(@Text(ReleasedDate) = ""; ""; @Text(ReleasedDate; "D0S0"))</formula></code>
</column>
<column itemname='EstimatedShipDate' width='10' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Est. Ship'/>
<code event='value'><formula>@If(@Text(EstimatedShipDate) = ""; ""; @Text(EstimatedShipDate; "D0S0"))</formula></code>
</column>
<column itemname='ShippedDate' width='10' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Shipped'/>
<code event='value'><formula>@If(@Text(ShippedDate) = ""; ""; @Text(ShippedDate; "D0S0"))</formula></code>
</column>
<column itemname='TrackingNumber' width='20' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Tracking'/>
<code event='value'><formula>TrackingNumber</formula></code>
</column>
<column itemname='CanModify' width='6' resizable='true' align='center'>
<font size='9pt' name='Arial'/>
<columnheader title='Modify?'/>
<code event='value'><formula>@If(@IsMember(@Trim(Status); "Released to Vendor":"In Production":"Shipped":"Complete":"Cancelled"); "No"; "Yes")</formula></code>
</column>
<item name='$Comment'><text>Lookup view behind StatusInquiry.xsp and HAASStatus.jss. Public access so anonymous EAMS-A pass-through users can query by document number. Rebuilt nightly by RebuildStatusInquiryIndex because the first column is multi-value and the index bloats.</text></item>
</view>
