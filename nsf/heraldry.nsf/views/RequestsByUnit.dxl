<code event='selection'><formula>SELECT Form = "Request" &amp; !@IsAvailable($Conflict) &amp; !@IsAvailable($Archived)</formula></code>
<column itemname='UIC' width='10' resizable='true' sort='ascending' categorized='true' twisties='true'>
<font size='9pt' style='bold' name='Arial'/>
<columnheader title='UIC'/>
<code event='value'><formula>@If(@Trim(UIC) = ""; "(No UIC)"; @UpperCase(UIC))</formula></code>
</column>
<column itemname='UnitName' width='30' resizable='true' sort='ascending' categorized='true' twisties='true'>
<font size='9pt' style='bold' name='Arial'/>
<columnheader title='Unit'/>
<code event='value'><formula>@If(@Trim(UnitName) = ""; "(Unit not recorded)"; UnitName)</formula></code>
</column>
<column itemname='DocumentNumber' width='16' resizable='true' sort='ascending'>
<font size='9pt' name='Arial'/>
<columnheader title='Document Number'/>
<code event='value'><formula>DocumentNumber</formula></code>
</column>
<column itemname='Status' width='16' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Status'/>
<code event='value'><formula>Status</formula></code>
</column>
<column itemname='RequestType' width='14' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Type'/>
<code event='value'><formula>RequestType</formula></code>
</column>
<column itemname='RequesterName' width='20' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Requester'/>
<code event='value'><formula>@If(@Trim(RequesterRank) = ""; RequesterName; RequesterRank + " " + RequesterName)</formula></code>
</column>
<column itemname='EnteredDate' width='10' resizable='true' sort='descending'>
<font size='9pt' name='Arial'/>
<columnheader title='Entered'/>
<code event='value'><formula>@Text(EnteredDate; "D0S0")</formula></code>
</column>
<column itemname='LineCount' width='5' resizable='true' align='right' totals='total'>
<font size='9pt' name='Arial'/>
<columnheader title='Lines'/>
<code event='value'><formula>LineCount</formula></code>
</column>
<column itemname='TotalValue' width='10' resizable='true' align='right' totals='total'>
<font size='9pt' name='Arial'/>
<numberformat format='currency' digits='2' punctuated='true' parens='false' percent='false'/>
<columnheader title='Value'/>
<code event='value'><formula>TotalValue</formula></code>
</column>
</view>
