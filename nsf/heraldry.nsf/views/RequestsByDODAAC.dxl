<code event='selection'><formula>SELECT Form = "Request" &amp; !@IsAvailable($Conflict)</formula></code>
<column itemname='DODAAC' width='10' resizable='true' sort='ascending' categorized='true' twisties='true'>
<font size='9pt' style='bold' name='Arial'/>
<columnheader title='DODAAC'/>
<code event='value'><formula>@If(@Trim(DODAAC) = ""; "(No DODAAC)"; @UpperCase(DODAAC))</formula></code>
</column>
<column itemname='DocumentNumber' width='16' resizable='true' sort='ascending'>
<font size='9pt' name='Arial'/>
<columnheader title='Document Number'/>
<code event='value'><formula>DocumentNumber</formula></code>
</column>
<column itemname='UnitName' width='30' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Unit'/>
<code event='value'><formula>UnitName</formula></code>
</column>
<column itemname='Status' width='16' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Status'/>
<code event='value'><formula>Status</formula></code>
</column>
<column itemname='FundCode' width='5' resizable='true' align='center'>
<font size='9pt' name='Arial'/>
<columnheader title='Fund'/>
<code event='value'><formula>FundCode</formula></code>
</column>
<column itemname='ProjectCode' width='5' resizable='true' align='center'>
<font size='9pt' name='Arial'/>
<columnheader title='Proj'/>
<code event='value'><formula>ProjectCode</formula></code>
</column>
<column itemname='ShipToDODAAC' width='10' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Ship-To'/>
<code event='value'><formula>@If(ShipToDODAAC = DODAAC; ""; ShipToDODAAC)</formula></code>
</column>
<column itemname='EnteredDate' width='10' resizable='true' sort='descending'>
<font size='9pt' name='Arial'/>
<columnheader title='Entered'/>
<code event='value'><formula>@Text(EnteredDate; "D0S0")</formula></code>
</column>
<column itemname='TotalValue' width='10' resizable='true' align='right' totals='total'>
<font size='9pt' name='Arial'/>
<numberformat format='currency' digits='2' punctuated='true' parens='false' percent='false'/>
