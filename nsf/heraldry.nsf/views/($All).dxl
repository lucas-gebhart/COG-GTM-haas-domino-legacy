<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE view SYSTEM 'xmlschemas/domino_12_0.dtd'>
<view name='($All)' xmlns='http://www.lotus.com/dxl' version='12.0'
 maintenanceversion='2.0' replicaid='C1258A1F00305C22' designerversion='8.5.3' publicaccess='false'
 showresponsehierarchy='false' showinmenu='false' onopengoto='lastopened' headers='beveled'
 bgcolor='white' headerbgcolor='#c0c0c0' rowlinecount='1' headerlinecount='1'>
<noteinfo noteid='156' unid='B8C9D0E1F2A3B4C585258A1F00305C22' sequence='9'>
<created><datetime>20040315T080000,00-05</datetime></created>
<modified><datetime>20090622T090000,00-04</datetime></modified>
</noteinfo>
<updatedby><name>CN=Domino Developer/O=HAAS</name></updatedby>
<code event='selection'><formula>SELECT @All</formula></code>
<column itemname='Form' width='14' resizable='true' sort='ascending' categorized='true' twisties='true'>
<font size='9pt' style='bold' name='Arial'/>
<columnheader title='Form'/>
<code event='value'><formula>@If(@Trim(Form) = ""; "(No Form)"; Form)</formula></code>
</column>
<column itemname='$Key' width='20' resizable='true' sort='ascending'>
<font size='9pt' name='Arial'/>
<columnheader title='Key'/>
<code event='value'><formula>@If(Form = "Request"; DocumentNumber; Form = "RequestLine"; LineDocNumber; Form = "SESFlagRequest"; SESFlagNumber; Form = "Vendor"; VendorKey; Form = "HeraldicItem"; StockNumber; Form = "Requester"; RequesterKey; Form = "Profile"; "Profile"; @Text(@DocumentUniqueID))</formula></code>
</column>
<column itemname='$Modified' width='16' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Modified'/>
<code event='value'><formula>@Text(@Modified; "D0S1")</formula></code>
</column>
<column itemname='$UpdatedBy' width='24' resizable='true'>
<font size='9pt' name='Arial'/>
<columnheader title='Last Editor'/>
<code event='value'><formula>@Name([Abbreviate]; @Subset($UpdatedBy; -1))</formula></code>
</column>
<column itemname='$Size' width='8' resizable='true' align='right'>
<font size='9pt' name='Arial'/>
<columnheader title='Size'/>
<code event='value'><formula>@DocLength</formula></code>
</column>
<column itemname='$Attachments' width='8' resizable='true' align='center'>
<font size='9pt' name='Arial'/>
<columnheader title='Att'/>
<code event='value'><formula>@If(@Attachments &gt; 0; @Text(@Attachments); "")</formula></code>
</column>
</view>
